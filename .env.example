# Sao chép thành .env (đã được .gitignore) và điền giá trị. KHÔNG commit .env lên GitHub.

APP_ENV=development
# Tài khoản quản trị đầu tiên (tạo tự động khi khởi động; không có mật khẩu mặc định)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1
# Mã mời để giáo viên tự đăng ký (để trống = giáo viên chỉ do admin tạo)
TEACHER_INVITE_CODE=

# Nếu giao diện đặt ở domain khác backend (vd GitHub Pages), liệt kê origin được phép, phân tách bằng dấu phẩy
CORS_ORIGINS=
# Đặt 1 khi chạy sau reverse proxy (Render, Railway, Nginx) để lấy đúng IP cho giới hạn tần suất
TRUST_PROXY=1

# ---- Nhà cung cấp AI: điền khóa của nhà nào thì nhà đó tự được bật ----
# Thứ tự ưu tiên & tự chuyển khi lỗi (admin có thể đổi trong trang /admin)
AI_PROVIDER_ORDER=gemini,groq,openrouter,anthropic,openai,ollama,mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Chạy mô hình local miễn phí với Ollama: đặt tên mô hình để bật
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Cho phép phương án offline "mock" khi mọi AI lỗi (khuyến nghị 0 khi chạy thật)
AI_ALLOW_MOCK=1

# ---- Quyền riêng tư ----
# Lưu 160 ký tự đầu của tin nhắn nguy cơ cao để quản trị viên can thiệp (0 = không lưu nội dung)
SAFETY_STORE_EXCERPT=1
DB_PATH=data/dualself.db
